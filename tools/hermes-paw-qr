        lines.append("档案显示名：\"" + name + "\"。")
    lines += [
        "1. 使用本机 Hermes 网关的 default 配置（默认 profile）；若不存在，报告并停下；",
        "2. 该配置的 API server 处于就绪状态：已启用、监听办公网络（非本机回环）、持有长效连接 key；若已就绪，核对后跳过；",
        "3. 生成 HermesPaw 接入二维码（hermespaw:// 配置串，单一档码），存到 /tmp/hermespaw-qr.png；",
        "4. 把图片文件 /tmp/hermespaw-qr.png 发给我；若当前通道无法发图片，改把 hermespaw:// 配置串贴到对话里（该文本含长效 key，仅可信通道发送、勿转发）；",
        "5. 若中途预检不通过（如 API server 不可达、无 key），报告具体原因与处置办法，不要出码；若需要重启网关，把重启命令告诉我，我重启完成后再继续；",
        "6. 我扫码完成后，提醒我删除 /tmp/hermespaw-qr.png。",
    ]
    print("\n".join(lines))
    return 0


def _prescan_lang(argv: list[str]) -> str | None:
    """在 argparse 之前扫出 --lang，好让 --help 本身也按所选语言渲染。"""
    for i, a in enumerate(argv):
        if a == "--lang" and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith("--lang="):
            return a.split("=", 1)[1]
    return None


def main() -> int:
    set_lang(_prescan_lang(sys.argv[1:]))
    ap = argparse.ArgumentParser(description=T("help_desc"))
    ap.add_argument("--apply", action="store_true", help=T("help_apply"))
    ap.add_argument("--list", action="store_true", help=T("help_list"))
    ap.add_argument("--host", help=T("help_host"))
    ap.add_argument("--name", help=T("help_name"))
    ap.add_argument("--once", action="store_true", help=T("help_once"))
    ap.add_argument("--json", action="store_true", help=T("help_json"))
    ap.add_argument("--png", metavar="PATH", help=T("help_png"))
    ap.add_argument("--prompt", action="store_true", help=T("help_prompt"))
    ap.add_argument("--no-selftest", action="store_true", help=T("help_no_selftest"))
    ap.add_argument("--lang", choices=("zh", "en"), help=T("help_lang"))
    args = ap.parse_args()
    set_lang(args.lang)  # 显式 --lang 覆盖环境推断
    # P1-r2-2 (170 审爷 r2): --json 仅用于 gen（出码 URI）；与 --prompt/--apply/--list 不兼容。
    # 此前非 gen 命令下 --json 静默 no-op（实测 --apply --json --png rc=0 照跑），误导 agent；改为 fail-closed。
    if args.json and (args.prompt or args.apply or args.list):
        die(T("json_only_gen"))

    if args.prompt:
        return cmd_prompt(args)
    if args.apply:
        return cmd_apply()
    if args.list:
        return cmd_list()
    return cmd_gen(args)


if __name__ == "__main__":
    sys.exit(main())
