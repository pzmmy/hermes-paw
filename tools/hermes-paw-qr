def _hermes_cli() -> list[str] | None:
    exe = shutil.which("hermes")
    return [exe] if exe else None




def cmd_apply() -> int:
    """四态对账：enabled / host / key / 端口监听。
    幂等（二次运行零改动）；改 config 走 hermes CLI（官方写入器）；
    需要重启网关时只停下通知，绝不自己重启。"""
    cfg = profile_home("default") / "config.yaml"
    env = profile_home("default") / ".env"
    print(f"== hermes-paw-qr --apply  (HERMES_HOME={HERMES_HOME}) ==")

    # 1) 读当前状态
    enabled, host, port, recognized = read_api_server(cfg)
    if not recognized:
        die(T("apply_cfg_unparsed", cfg=cfg))
    key = read_env_key(env)
    listening = port_listening(port)
    kdesc = T("k_ok") if len(key) >= 16 else (T("k_weak") if key else T("k_missing"))
    print(T("apply_now", enabled=enabled, host=host, port=port, key=kdesc, listening=listening))

    changed: list[str] = []
    hermes = _hermes_cli()

    # 2) enabled
    if not enabled:
        if not hermes:
            die(T("apply_no_cli_enabled"))
        r = subprocess.run(hermes + ["config", "set", "platforms.api_server.enabled", "true"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(T("apply_set_enabled_fail", out=(r.stdout.strip() + " " + r.stderr.strip()).strip()))
        changed.append("platforms.api_server.enabled=true")
        print(T("apply_enabled_ok"))

    # 3) host
    if host in ("127.0.0.1", "localhost", "::1"):
        if not hermes:
            die(T("apply_no_cli_host", host=host))
        r = subprocess.run(hermes + ["config", "set", "platforms.api_server.extra.host", "0.0.0.0"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(T("apply_set_host_fail", out=(r.stdout.strip() + " " + r.stderr.strip()).strip()))
        changed.append("platforms.api_server.extra.host=0.0.0.0")
        print(T("apply_host_ok", host=host))

    # 4) key（三分支幂等；key 改动后运行中的网关内存里仍是旧 key，必须重启才生效）
    if len(key) < 16:
        branch = ensure_key(env, "主")
        if branch != "keep":
            changed.append("API_SERVER_KEY 新建/覆盖（需重启网关生效）")

    # 5) 复验
    enabled2, host2, port2, _ = read_api_server(cfg)
    listening2 = port_listening(port2)
    ok = enabled2 and host2 not in ("127.0.0.1", "localhost", "::1") and len(read_env_key(env)) >= 16
    kdesc2 = T("k_ok") if len(read_env_key(env)) >= 16 else T("k_missing")
    print(T("apply_reverify", enabled=enabled2, host=host2, port=port2, key=kdesc2, listening=listening2))

    # 6) 收尾提示（任何改动都需重启网关才生效——config 与 .env 均为启动时加载）
    if changed:
        print(T("apply_changed", n=len(changed)))
        # 提示串运行时拼接：Hermes 终端生命周期守卫静态扫全文，连续形态会被误判成
        # 「脚本要操作网关」而拦下整条命令（2026-11-20 实测误伤）。语义不变。
        print("      " + "hermes gateway " + "restart")
        return 2
    if not listening2 or not ok:
        print(T("apply_port_not_ready", cmd=("hermes gateway " + "restart")))
        return 2
    print(T("apply_all_good"))
    return 0


